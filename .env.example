# Copy this file to .env on your computer. NEVER upload .env to GitHub.
APP_ENV=development
# Put a long random text here (64+ characters). Example generator: https://generate-secret.vercel.app/64
APP_KEY=
TRUST_PROXY=0
APP_URL=http://hotelgo.test

# --- Database (local Laragon) ---
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hotelgo
DB_USER=root
DB_PASSWORD=
# Aiven only: path to the CA certificate file (see guide)
DB_SSL_CA=
DB_CHARSET=utf8mb4

# --- JSON API / React console (REQUIRED for /api and /panel). Two DIFFERENT random texts, 32+ characters each.
# Generate each one with:  php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
REFRESH_TOKEN_KEY=

# --- Hidden staff sign-in (IMPORTANT). The staff/owner login page is not linked anywhere. Only you know its address.
# Choose your own secret word (8+ letters/numbers/dashes). Staff open https://your-site/<this word>
STAFF_LOGIN_PATH=

# --- Integrations (leave empty = safe "simulation" mode) ---
# Payment: PAYMENT_PROVIDER=mock (fake sandbox page) or paymongo (real, start with TEST keys).
PAYMENT_PROVIDER=mock
PAYMONGO_SECRET_KEY=
# From PayMongo -> Developers -> Webhooks (starts with whsk_). Needed so a payment is confirmed even if the guest closes the browser.
PAYMONGO_WEBHOOK_SECRET=
# Payment methods you activated in PayMongo, comma separated (gcash, paymaya, card, grab_pay, qrph, dob, dob_ubp)
PAYMONGO_METHODS=gcash,paymaya,card
# EMAIL (free): EMAIL_PROVIDER=appsscript sends from YOUR Gmail through a small Google Apps Script (see the guide, Part 8).
#   Sign-up and password-reset codes are emailed. 100 emails per day, no domain needed, works on Render free.
EMAIL_PROVIDER=log
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
MAIL_FROM_NAME=HOTELGO
# (optional) Resend instead: EMAIL_PROVIDER=resend + RESEND_API_KEY + MAIL_FROM (needs a domain you own to email other people)
RESEND_API_KEY=
MAIL_FROM=
# SMS is optional and paid. Leave as log = messages are only saved (demo).
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER=
SMS_OTP_ROUTE=messages
# Only if you get an "SSL certificate" error on Windows: path to cacert.pem (Laragon: C:\laragon\etc\ssl\cacert.pem)
CURL_CA_BUNDLE=
# 1000 = no limit on unpaid bookings (demo). Use 3 on a real site.
MAX_UNPAID_BOOKINGS=1000
# Maps: leave empty to use the free OpenStreetMap map. Optional Google key for the Google embed.
GOOGLE_MAPS_KEY=

# --- School demo only: show verification codes on screen and allow the fake payment page on Render ---
DEMO_SHOW_CODES=0
ALLOW_MOCK_PAYMENT=0
